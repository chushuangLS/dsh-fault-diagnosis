# 换行符策略
#
# core.autocrlf 在 Windows 上默认把仓库里的文件签出成 CRLF。
# 这对 shell 脚本是致命的：CRLF 的 start.sh 在 Linux 上会报
#   bash: ./start.sh: /bin/bash^M: bad interpreter
# 所以这里按文件类型显式指定，不依赖各机器的 git 配置。
#
# 文本文件默认自动识别
* text=auto

# Shell 脚本必须是 LF，否则 Linux/macOS 无法执行
*.sh   text eol=lf

# Windows 脚本用 CRLF 更稳（部分编辑器/工具对 LF 的 .bat 处理不佳）
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# Python / 前端源码统一 LF
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

# 二进制文件不要做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.xlsx binary
*.zip  binary
