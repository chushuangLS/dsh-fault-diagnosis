# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
venv/
env/
ENV/
.venv

# 环境变量（含密钥，绝对不能提交）
.env
.env.local
*.env

# IDE
# 保留 .vscode/settings.json（团队共享的编辑器配置），排除个人配置
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
desktop-error.log     # 桌面窗口版的报错日志（窗口无控制台）
logs/

# 运维记录（含实际教室号和故障信息，不公开）
data/repair_records.csv
# 运行时数据（教室台账、日常报备），仓库内只保留示例文件
data/classrooms.json
data/daily_tasks.json

# 课表数据（含真实教师姓名、教学班、选课人数，绝对不能公开）
#
# 接口层已经做了教师脱敏（只保留姓），这里再加一道：
# 若误提交，真实姓名会永久留在 git 历史里，删也删不干净。
data/schedule.json
data/schedule.json.lock

# 知识库自动沉淀（程序每次诊断后追加，属运行时数据）
# 手工维护的知识库 data/fault_cases.json 仍然提交，
# 这样人工积累的经验可以随仓库传递、评审和回滚。
data/fault_cases_auto.json
data/fault_cases_auto.json.lock

# 导出的报表（运行时产物，含真实教室与故障信息）
exports/

# 文件锁（并发写入保护用的空文件，运行时生成）
*.lock

# 数据文件备份（迁移脚本会生成 .bak，属本地过程产物）
*.bak

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# PyInstaller 构建产物
tools/_debug.spec
